#!/bin/bash

# Fail fast: exit on errors, treat unset variables as errors, and fail a
# pipeline if any stage fails. -E ensures the ERR trap fires inside functions.
set -Eeuo pipefail

# Report unexpected failures with the line number that triggered them.
trap 'echo "Error: hugov failed at line ${LINENO} (exit $?)." >&2' ERR

# Resolve the actual path of the script, following any symlinks
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
# Get the directory of the resolved script path
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Default configuration
# Directory for the symlink to the Hugo executable
BINDIR="/usr/local/bin"
# Oldest version to download. Downloads walk the release history from newest to
# oldest and stop once this version is reached (it is the last one fetched).
# Override with the HUGOV_STOP_VERSION environment variable.
STOP_VERSION="${HUGOV_STOP_VERSION:-v0.140.0}"
# Download Directory
DOWNLOAD_DIR="$SCRIPT_DIR/executables"
# The GoHugo releases API URL
BASE_URL="https://api.github.com/repos/gohugoio/hugo/releases"
# Where release assets are published
HOST_URL="https://github.com/gohugoio/hugo/releases/download"

# Which build flavor to operate on: standard, extended, or both. Defaults to
# extended (the most commonly used). FLAVOR_SET tracks whether the user picked
# one explicitly so interactive commands know to skip their prompt.
FLAVOR="extended"
FLAVOR_SET=false
# Optional directory to mirror raw GitHub API responses into (for debugging).
LOG_DIR=""
# Selected action and its optional arguments (set during argument parsing).
ACTION=""
DOWNLOAD_VERSION=""
PRUNE_KEEP=5
# Skip SHA256 checksum verification when set to true.
NO_VERIFY=false

# Platform values, populated by detect_platform.
OS=""
ARCH=""

# Build the Authorization header arguments from a GitHub token, if present.
# Honoring a token raises the API limit from 60 to 5000 requests per hour.
GH_AUTH=()
_gh_token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
if [ -n "$_gh_token" ]; then
  GH_AUTH=(-H "Authorization: Bearer $_gh_token")
fi
unset _gh_token

# Check if required dependencies are installed.
check_dependencies() {
  local missing=0
  for cmd in jq curl tar rm ln find sed sort; do
    if ! command -v "$cmd" &>/dev/null; then
      echo "Error: $cmd is not installed."
      missing=1
    fi
  done
  if [ "$missing" -ne 0 ]; then
    echo "Please install the required dependencies and try again."
    exit 1
  fi
}

# Display help message
show_help() {
  echo "Usage: $0 [OPTIONS]"
  echo ""
  echo "Actions (mutually exclusive):"
  echo "  --download [version]  Download missing versions, or a single <version> if given."
  echo "  --list                List already downloaded Hugo versions."
  echo "  --link                Symlink a chosen version into BINDIR."
  echo "  --update              Download the latest versions and link the newest."
  echo "  --current             Show which version BINDIR/hugo currently points at."
  echo "  --uninstall           Remove the BINDIR/hugo symlink."
  echo "  --prune               Delete old downloaded versions (see --keep)."
  echo "  --version             Display the script version."
  echo "  --help                Display this help message."
  echo ""
  echo "Options:"
  echo "  --bindir <directory>  Directory for the Hugo symlink (default: $BINDIR)."
  echo "  --extended            Operate on extended builds (default)."
  echo "  --standard            Operate on standard builds."
  echo "  --both                Download both standard and extended builds."
  echo "  --keep <n>            With --prune, keep the newest <n> versions (default: $PRUNE_KEEP)."
  echo "  --log-dir <directory> Mirror raw GitHub API responses into <directory>."
  echo "  --no-verify           Skip SHA256 checksum verification of downloads."
  echo ""
  echo "Environment:"
  echo "  HUGOV_STOP_VERSION    Oldest version to download (default: $STOP_VERSION)."
  echo "  GITHUB_TOKEN/GH_TOKEN GitHub token used to raise the API rate limit."
}

# Detect the operating system and CPU architecture, normalizing to the names
# Hugo uses in its release asset filenames.
detect_platform() {
  local kernel machine
  kernel="$(uname -s)"
  machine="$(uname -m)"
  case "$kernel" in
  Linux) OS="linux" ;;
  Darwin) OS="darwin" ;;
  *) OS="$(echo "$kernel" | tr '[:upper:]' '[:lower:]')" ;;
  esac
  case "$machine" in
  x86_64 | amd64) ARCH="amd64" ;;
  aarch64 | arm64) ARCH="arm64" ;;
  *) ARCH="$machine" ;;
  esac
}

# Helper function to compare two versions using version sorting.
version_ge() {
  # Returns 0 if $1 >= $2, else 1
  [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" == "$2" ]]
}

# Perform a GitHub API request, including the auth header when available.
api_curl() {
  curl -s ${GH_AUTH[@]+"${GH_AUTH[@]}"} "$@"
}

# Build the download URL for a given version and flavor (standard|extended).
build_asset_url() {
  local version="$1"
  local flavor="$2"
  # Hugo switched the linux/amd64 asset naming from "Linux-64bit" to
  # "linux-amd64" at v0.102.3; everything else uses the modern scheme.
  local mid_version="v0.102.3"
  local ver="${version#v}"
  local ext_prefix=""
  [[ "$flavor" == "extended" ]] && ext_prefix="extended_"

  local platform
  if [[ "$OS" == "linux" && "$ARCH" == "amd64" ]] && ! version_ge "$version" "$mid_version"; then
    platform="Linux-64bit"
  elif [[ "$OS" == "darwin" ]]; then
    platform="darwin-universal"
  else
    platform="${OS}-${ARCH}"
  fi

  printf '%s/%s/hugo_%s%s_%s.tar.gz' "$HOST_URL" "$version" "$ext_prefix" "$ver" "$platform"
}

# Verify a downloaded archive against Hugo's published checksums file.
# Returns 0 when verified or when verification is unavailable/skipped.
verify_checksum() {
  local version="$1"
  local flavor="$2"
  local archive="$3"

  if $NO_VERIFY; then
    return 0
  fi
  if ! command -v sha256sum &>/dev/null; then
    echo "Warning: sha256sum not found; skipping checksum verification." >&2
    return 0
  fi

  local ver="${version#v}"
  local asset_name checksums_url checksums expected actual
  asset_name="$(basename "$(build_asset_url "$version" "$flavor")")"
  checksums_url="${HOST_URL}/${version}/hugo_${ver}_checksums.txt"
  checksums="$(curl -fsSL "$checksums_url" 2>/dev/null || true)"

  if [ -z "$checksums" ]; then
    echo "Warning: could not fetch checksums for $version; skipping verification." >&2
    return 0
  fi

  expected="$(echo "$checksums" | awk -v f="$asset_name" '$2 == f {print $1}')"
  if [ -z "$expected" ]; then
    echo "Warning: no checksum listed for $asset_name; skipping verification." >&2
    return 0
  fi

  actual="$(sha256sum "$archive" | awk '{print $1}')"
  if [ "$expected" != "$actual" ]; then
    echo "Error: checksum mismatch for $asset_name (expected $expected, got $actual)." >&2
    return 1
  fi
  return 0
}

# Run a command with sudo only when BINDIR is not writable by the current user.
maybe_sudo() {
  if [ -w "$BINDIR" ]; then
    "$@"
  else
    sudo "$@"
  fi
}

# Show script version by reading package.json
show_version() {
  local package_json="$SCRIPT_DIR/package.json"
  if [ -f "$package_json" ]; then
    version=$(jq -r '.version' "$package_json" 2>/dev/null || true)
    if [ "$version" != "null" ]; then
      echo "Script version: $version"
    else
      echo "Version not found in package.json."
    fi
  else
    echo "package.json not found."
  fi
}

# Return the unique downloaded version numbers, oldest to newest.
downloaded_versions() {
  find "$DOWNLOAD_DIR" -type f -name "hugo-*" 2>/dev/null |
    sed -E 's/.*\/hugo-(v?[0-9]+\.[0-9]+\.[0-9]+)(-extended)?$/\1/' |
    sort -uV || true
}

# Function to list versions in the downloads folder
list_downloaded_versions() {
  echo "Downloaded Hugo versions:"
  if [ -d "$DOWNLOAD_DIR" ]; then
    find "$DOWNLOAD_DIR" -type f -name "hugo-*" | sed -E 's/.*\/hugo-([^-]+)(-extended)?$/\1\2/' | sort -uV
  else
    echo "No versions downloaded yet."
  fi
}

# Download and install a single flavor (standard|extended) of one version.
download_flavor() {
  local version="$1"
  local flavor="$2"
  local suffix=""
  [[ "$flavor" == "extended" ]] && suffix="-extended"

  local executable="$DOWNLOAD_DIR/hugo-${version}${suffix}"
  local archive="$DOWNLOAD_DIR/hugo-${version}${suffix}.tar.gz"

  if [ -f "$executable" ]; then
    echo "Skipping $flavor $version, executable already exists."
    return 0
  fi

  local url
  url="$(build_asset_url "$version" "$flavor")"
  echo "Downloading $flavor Hugo $version from $url..."
  if ! curl -fsSL -o "$archive" "$url"; then
    echo "Error: failed to download $flavor Hugo $version."
    rm -f "$archive"
    return 0
  fi

  if ! tar -tzf "$archive" &>/dev/null; then
    echo "Error: $flavor Hugo $version is not a valid tar.gz archive."
    rm -f "$archive"
    return 0
  fi

  if ! verify_checksum "$version" "$flavor" "$archive"; then
    rm -f "$archive"
    return 0
  fi

  echo "Extracting $flavor Hugo $version..."
  tar -xzf "$archive" -C "$DOWNLOAD_DIR" "hugo" && mv "$DOWNLOAD_DIR/hugo" "$executable"
  rm -f "$archive"
}

# Download the requested flavor(s) of a single version.
download_single_version() {
  local version="$1"
  local flavors=()
  case "$FLAVOR" in
  standard) flavors=(standard) ;;
  extended) flavors=(extended) ;;
  both) flavors=(standard extended) ;;
  esac
  local flavor
  for flavor in "${flavors[@]}"; do
    download_flavor "$version" "$flavor"
  done
}

# Function to download and extract Hugo releases listed on one API page.
download_releases_from_page() {
  local page_content="$1"
  local versions
  versions=$(echo "$page_content" | jq -r '.[].tag_name' || true)

  for version in $versions; do
    download_single_version "$version"

    # Stop once the oldest requested version has been fetched.
    if [[ "$version" == "$STOP_VERSION" ]]; then
      echo "Reached version $STOP_VERSION. Stopping further downloads."
      return 1 # Signal to stop the outer loop in download_versions
    fi
  done
  return 0
}

# Function to download missing versions
download_versions() {
  echo "Downloading only missing versions of Hugo. Existing files will be skipped."
  mkdir -p "$DOWNLOAD_DIR"
  [ -n "$LOG_DIR" ] && mkdir -p "$LOG_DIR"
  page_number=1
  while true; do
    page_url="${BASE_URL}?per_page=100&page=${page_number}"
    page_content=$(api_curl "$page_url" || true)
    echo "Processing page $page_number..."

    if [ -n "$LOG_DIR" ]; then
      printf '%s' "$page_content" >"$LOG_DIR/releases-page-${page_number}.json"
    fi

    if [ -z "$page_content" ] || [ "$page_content" == "[]" ]; then
      break
    fi

    if [[ "$page_content" == *"API rate limit exceeded"* ]]; then
      echo "API rate limit exceeded. Set GITHUB_TOKEN or GH_TOKEN to raise the limit to 5000/hour, or wait."
      break
    fi

    # Download releases from this page and stop if STOP_VERSION is reached
    if ! download_releases_from_page "$page_content"; then
      break
    fi
    page_number=$((page_number + 1))
  done
}

# Function to update by downloading and linking the latest version
update_versions() {
  download_versions

  # Determine the latest version
  local latest_version
  latest_version=$(downloaded_versions | tail -n 1)
  echo "Latest downloaded version: $latest_version"

  link_to_version "$latest_version"
}

# Resolve the executable path for a version honoring the chosen/asked flavor.
resolve_executable() {
  local version="$1"
  local want_extended

  if $FLAVOR_SET; then
    [[ "$FLAVOR" == "standard" ]] && want_extended=false || want_extended=true
  else
    local answer
    read -r -p "Do you want the extended version? (Y/n): " answer || true
    answer="${answer:-Y}"
    [[ "$answer" =~ ^[Yy]$ ]] && want_extended=true || want_extended=false
  fi

  if $want_extended; then
    echo "$DOWNLOAD_DIR/hugo-${version}-extended"
  else
    echo "$DOWNLOAD_DIR/hugo-${version}"
  fi
}

# Atomically point BINDIR/hugo at the executable for the given version.
link_to_version() {
  local version="$1"
  local selected_executable
  selected_executable="$(resolve_executable "$version")"

  if [ ! -f "$selected_executable" ]; then
    echo "Error: $(basename "$selected_executable") is not downloaded."
    exit 1
  fi
  selected_executable="$(realpath "$selected_executable")"

  if [ ! -w "$BINDIR" ]; then
    echo "This operation needs sudo to write into $BINDIR."
  fi
  # ln -sfn replaces the symlink atomically, leaving no window without hugo.
  maybe_sudo ln -sfn "$selected_executable" "$BINDIR/hugo"
  echo "Symlink created: $BINDIR/hugo -> $selected_executable"
}

# Function to create a symlink for a specified version
link_version() {
  local available_versions latest_version selected_version
  available_versions="$(downloaded_versions)"
  latest_version=$(echo "$available_versions" | tail -n 1)

  echo "Available versions to link:"
  echo "$available_versions"

  read -r -p "Enter the version you want to symlink (default is latest: $latest_version): " selected_version || true
  selected_version="${selected_version:-$latest_version}"

  link_to_version "$selected_version"
}

# Show which version BINDIR/hugo currently points at.
current_version() {
  local link="$BINDIR/hugo"
  if [ ! -e "$link" ] && [ ! -L "$link" ]; then
    echo "No hugo symlink found at $link."
    return 0
  fi
  local target
  target="$(readlink -f "$link" 2>/dev/null || true)"
  if [ -z "$target" ]; then
    echo "$link is a broken symlink."
    return 0
  fi
  echo "$link -> $target"
  echo "Version: ${target##*/hugo-}"
}

# Remove the BINDIR/hugo symlink.
uninstall_version() {
  local link="$BINDIR/hugo"
  if [ -L "$link" ] || [ -e "$link" ]; then
    if [ ! -w "$BINDIR" ]; then
      echo "This operation needs sudo to remove $link."
    fi
    maybe_sudo rm -f "$link"
    echo "Removed $link."
  else
    echo "Nothing to remove at $link."
  fi
}

# Delete old downloaded versions, keeping the newest $PRUNE_KEEP.
prune_versions() {
  if ! [[ "$PRUNE_KEEP" =~ ^[0-9]+$ ]]; then
    echo "Error: --keep requires a non-negative integer." >&2
    exit 1
  fi

  local versions total to_remove
  versions="$(downloaded_versions)"
  total="$(echo "$versions" | grep -c . || true)"

  if [ "$total" -le "$PRUNE_KEEP" ]; then
    echo "Nothing to prune ($total downloaded, keeping $PRUNE_KEEP)."
    return 0
  fi

  to_remove="$(echo "$versions" | head -n "$((total - PRUNE_KEEP))")"
  echo "The following versions will be removed (keeping the newest $PRUNE_KEEP):"
  echo "$to_remove"
  local confirm
  read -r -p "Proceed? (y/N): " confirm || true
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Aborted."
    return 0
  fi

  local v
  while IFS= read -r v; do
    [ -z "$v" ] && continue
    rm -f "$DOWNLOAD_DIR/hugo-$v" "$DOWNLOAD_DIR/hugo-$v-extended"
    echo "Removed $v"
  done <<<"$to_remove"
}

# Record the chosen action, enforcing that only one is selected.
set_action() {
  if [ -n "$ACTION" ]; then
    echo "Error: --$1 cannot be combined with --$ACTION." >&2
    exit 1
  fi
  ACTION="$1"
}

# Main logic
main() {
  check_dependencies
  detect_platform

  # Process arguments
  if [[ $# -eq 0 ]]; then
    show_help
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help)
      show_help
      exit 0
      ;;
    --version)
      show_version
      exit 0
      ;;
    --list)
      set_action list
      ;;
    --download)
      set_action download
      # Accept an optional single version argument.
      if [[ $# -ge 2 && "$2" != --* ]]; then
        DOWNLOAD_VERSION="$2"
        shift
      fi
      ;;
    --link)
      set_action link
      ;;
    --update)
      set_action update
      ;;
    --current)
      set_action current
      ;;
    --uninstall)
      set_action uninstall
      ;;
    --prune)
      set_action prune
      ;;
    --keep)
      if [[ $# -lt 2 ]]; then
        echo "Error: --keep requires a number argument."
        exit 1
      fi
      shift
      PRUNE_KEEP="$1"
      ;;
    --bindir)
      if [[ $# -lt 2 ]]; then
        echo "Error: --bindir requires a directory argument."
        exit 1
      fi
      shift
      BINDIR="$1"
      ;;
    --log-dir)
      if [[ $# -lt 2 ]]; then
        echo "Error: --log-dir requires a directory argument."
        exit 1
      fi
      shift
      LOG_DIR="$1"
      ;;
    --extended)
      FLAVOR="extended"
      FLAVOR_SET=true
      ;;
    --standard)
      FLAVOR="standard"
      FLAVOR_SET=true
      ;;
    --both)
      FLAVOR="both"
      FLAVOR_SET=true
      ;;
    --no-verify)
      NO_VERIFY=true
      ;;
    *)
      echo "Invalid option: $1. Use --help for available options."
      exit 1
      ;;
    esac
    shift
  done

  # Execute the selected action.
  case "$ACTION" in
  download)
    if [ -n "$DOWNLOAD_VERSION" ]; then
      mkdir -p "$DOWNLOAD_DIR"
      download_single_version "$DOWNLOAD_VERSION"
    else
      download_versions
    fi
    ;;
  list) list_downloaded_versions ;;
  link) link_version ;;
  update) update_versions ;;
  current) current_version ;;
  uninstall) uninstall_version ;;
  prune) prune_versions ;;
  "") show_help ;;
  esac
}

# Run only when executed directly, so tests can source this file for unit tests.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
