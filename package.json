{
  "name": "hugo-versioning",
  "description": "A quick and dirty GoHugo version selector for bash",
  "version": "2026.2.1",
  "license": "MIT",
  "author": "Patrick Kollitsch <patrick@davids-neighbour.com>",
  "keywords": [
    "hugo",
    "versioning",
    "bash"
  ],
  "devDependencies": {
    "@dnbhq/markdownlint-config": "2.0.0",
    "bats": "1.13.0",
    "rimraf": "6.1.4",
    "wireit": "0.14.13"
  },
  "scripts": {
    "clean": "rimraf executables/* .wireit",
    "lint": "shellcheck hugov",
    "test": "bats test",
    "release": "wireit"
  },
  "wireit": {
    "release": {
      "command": "release-it --config .release-it.ts --ci"
    }
  },
  "dependencies": {
    "@release-it/conventional-changelog": "12.0.2",
    "release-it": "21.1.2"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.1"
    },
    "release-it": {
      "undici": "^7.29.1"
    }
  }
}
