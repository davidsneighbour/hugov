{
  "name": "hugo-versioning",
  "description": "A quick and dirty GoHugo version selector for bash",
  "version": "2026.0.0",
  "license": "MIT",
  "author": "Patrick Kollitsch <patrick@davids-neighbour.com>",
  "keywords": [
    "hugo",
    "versioning",
    "bash"
  ],
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "15.3.5",
    "@davidsneighbour/remark-config": "2026.0.3",
    "@davidsneighbour/tools": "2026.0.5",
    "@dnbhq/markdownlint-config": "0.2.7"
  },
  "scripts": {
    "clean": "rimraf executables/* .wireit",
    "lint": "shellcheck hugov bin/repo/release/postrelease",
    "release": "wireit"
  },
  "wireit": {
    "release": {
      "command": "release-it --config .release-it.ts --ci"
    }
  },
  "dependencies": {
    "@release-it/conventional-changelog": "11.0.1",
    "release-it": "20.2.0"
  }
}
